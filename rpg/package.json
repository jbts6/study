{
  "name": "python-rpg",
  "displayName": "奥术战术 RPG",
  "description": "在 VS Code 中编写战术程序，并在侧边编辑器组中推进六关战术 RPG。",
  "private": true,
  "publisher": "local",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "node": "24.15.0",
    "vscode": "^1.125.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onCommand:pythonRpg.open",
    "onView:pythonRpg.launcher"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pythonRpg",
          "title": "奥术战术 RPG",
          "icon": "media/python-rpg.svg"
        }
      ]
    },
    "views": {
      "pythonRpg": [
        {
          "id": "pythonRpg.launcher",
          "name": "奥术战术 RPG",
          "icon": "media/python-rpg.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "pythonRpg.open",
        "title": "奥术战术 RPG: 打开游戏"
      },
      {
        "command": "pythonRpg.runTurn",
        "title": "奥术战术 RPG: 运行当前回合"
      }
    ],
    "keybindings": [
      {
        "command": "pythonRpg.runTurn",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorLangId == python"
      }
    ],
    "configuration": {
      "title": "奥术战术 RPG",
      "properties": {
        "pythonRpg.pythonPath": {
          "type": "string",
          "default": "",
          "description": "可选的 Python 3.12+ 可执行文件路径；留空时自动检测。"
        }
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:web && npm run build:extension && npm run build:webview",
    "build:web": "vite build",
    "build:extension": "node esbuild.extension.mjs",
    "build:extension-test": "node esbuild.extension-test.mjs",
    "build:webview": "node esbuild.webview.mjs",
    "package:vsix": "npm run build && vsce package --out dist/python-rpg.vsix",
    "install:local": "npm run package:vsix && code --install-extension dist/python-rpg.vsix --force",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:extension": "npm run typecheck && npm run build:extension && npm run build:webview && npm run build:extension-test && node src/vscode/test/run-extension-tests.mjs",
    "runner": "node --experimental-strip-types src/runners/local/runner-cli.ts",
    "runner:dev": "node --watch --experimental-strip-types src/runners/local/runner-cli.ts"
  },
  "dependencies": {
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.1",
    "codemirror": "^6.0.2",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/vscode": "^1.125.0",
    "@types/ws": "8.18.1",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
